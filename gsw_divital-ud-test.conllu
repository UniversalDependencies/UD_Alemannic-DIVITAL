# newdoc id = ala_138
# title = ETTENDORF 02 - Texte alsacien
# transcriber = Pascale Erhart, Dominique Huck
# source = "Ethnotexte Ettendorf 2" (1965), collected by Ernest Beyer, published by Département de dialectologie alsacienne et mosellane de l'Université de Strasbourg, URL: https://cocoon.huma-num.fr/data/ala/masters/ALA_803.pdf
# genre = anecdote
# audience = undefined
# discourse_type = narrative
# domain = personal
# factuality = non-fictional
# form = dialog
# origin = transcription
# channel = digital
# language_glottolog = Alsace Low Alemannic (alsa1241)
# language_variety = Northern Low Alemannic / Lower Alsace
# sample_type = excerpts
# sent_id = ala_138.30
# text = Un no hàn mer so die Köjle ghet, hàn mer se àls uf Dreieck gsetzt, sin àls so veer, fenef wie mit hàn gspielt, no hàn mer e Dreieck gemolt mit ere Kried uf d'Stroos, un uf des Dreieck, do sin hiwe un diwe esch eins gsetzt wore, un owe uf's Eck, un no hiwe un diwe, wàs dezwische gewaan esch, do sin a noch dezwische, un no het mer gewessi Màsse Streck genumme, ich wod sàje, ebene fenef, sechs Meter devon esch mer gebliewe, un no het mer so Köjle g'het, so üs Stein gedrajt, oder Holzköjle, oder Bliiköjle, un no het mer geworfe, het mer de Ding gezeilt, uf die Springkejele, un der wie se no getroffe het, der het no àls widdersch derffe spiele, bis dàs er kenni meh getroffe het, un no esch de Nachscht dràn kumme, un no esch's àls noch de Reje gànge, un die het mer ö gepàlte.
# text_orig = Un no hàn mer so die Köjle ghet, hàn mer se àls uf Dreieck gsetzt, sin àls so veer, fenef wie mit hàn gspielt, no hàn mer e Dreieck gemolt mit ere Kried uf d'Stroos, un uf des Dreieck, do sin hiwe un diwe esch eins gsetzt wore, un owe uf's Eck, un no hiwe un diwe, wàs dezwische gewaan esch, do sin a noch dezwische, un no het mer gewessi Màsse Streck genumme, ich wod sàje, ebene fenef, sechs Meter devon esch mer gebliewe, un no het mer so Köjle g'het, so üs Stein gedrajt, oder Holzköjle, oder Bliiköjle, un no het mer geworfe, het mer die Ding gezeilt, uf die Springkejele, un der wie se no getroffe het, der het no àls widdersch deffe spiele, bis dàs er kenni meh getroffe het, un no eschd de Nachscht dràn kumme, un no esch's àls noch de Reje gànge, un die het mer ö gepàlte.
